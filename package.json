{
  "name": "sensei-learning",
  "version": "1.0.0",
  "description": "Local learning platform for Claude artifacts",
  "main": "electron/main.js",
  "author": "lonelyfrank",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src electron --ext .js,.jsx",
    "format": "prettier --write src electron"
  },
  "build": {
    "appId": "com.lonelyfrank.sensei-learning",
    "productName": "Sensei Learning",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/db/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/lucide-react.min.js",
        "to": "lucide-react.min.js"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/sensei-learning-icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/sensei-learning-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/sensei-learning-icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.9.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "vite": "^8.0.8",
    "vite-plugin-dynamic-import": "^1.6.0",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^9.0.5"
  }
}
